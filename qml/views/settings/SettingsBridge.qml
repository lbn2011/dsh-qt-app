// SettingsBridge.qml — the QML half of the settings/models RPC.
//
// The settings page never talks to a Node service directly: it goes through the
// native `ctx.host` object, whose `request(method, params)` returns a request id
// immediately and whose `requestReplied(id, method, ok, result, error)` signal
// settles it later. This component owns that correlation table and hands out
// promise-shaped callbacks, so a form only has to say what it wants.
//
// Contract notes (from the I3 plan):
//
//   * `settings.describe` is asked for redacted secrets; the server redacts on
//     its side and this bridge never receives a secret value.
//   * `settings.mutate` carries path operations only. A conflict arrives as
//     `conflict` with `expected`/`actual` details; the form shows it, it does not
//     retry with a stale revision.
//   * `llm.models.discover` is cancellable; `cancelDiscover` aborts the same
//     operation id, and a late success is reported as `cancelled` by the server.
//   * credentials are write-only from this side: `cred.set`/`cred.unset` take a
//     draft, and `cred.describe` returns configured/source/writable — never the
//     value.
pragma ComponentBehavior: Bound

import QtQuick

QtObject {
    id: root

    objectName: "settingsBridge"

    /**
     * The native host object. It is `ctx.host` in the real window; tests inject
     * a stub with the same `request`/`cancelRequest` surface.
     */
    property var host: null

    /** Namespaces from the last successful describe. */
    property var descriptors: []

    /** Highest revision reported by the last describe, or -1 when unknown. */
    property int revision: -1

    /** Providers from the last successful `llm.providers.list`. */
    property var providers: []

    /** Current default selection (`{provider, model, reasoningEffort?}`). */
    property var defaultSelection: ({})

    /** Human-readable last failure; cleared by the next successful call. */
    property string lastError: ""

    /** True while at least one request is in flight. */
    property bool busy: root._pendingCount > 0

    property int _pendingCount: 0
    property var _pending: ({})
    property int _sequence: 0

    signal loaded()
    // `providersChanged` is generated by the `providers` property above.
    signal defaultChanged()
    signal failed(string code, string message)

    /** Emitted when a mutation lands; `conflict` is false for a clean write. */
    signal mutated(string namespace, bool conflict)

    // ------------------------------------------------------------------ core

    /** True when the bridge can talk to a host. */
    function available() {
        return root.host !== null && root.host !== undefined && typeof root.host.request === "function"
    }

    /**
     * Send one request. `callback(ok, result, error)` runs exactly once, unless
     * the request is cancelled with `cancel(id)`. Returns the request id, or ""
     * when there is no host (in which case the callback already ran with
     * `unavailable`).
     */
    function call(method, params, callback) {
        if (!root.available()) {
            var message = "the Qt host bridge is not attached"
            root.lastError = message
            if (callback)
                callback(false, null, message)
            root.failed("unavailable", message)
            return ""
        }
        var key = String(method)
        var id = String(root.host.request(key, params === undefined || params === null ? ({}) : params))
        if (id === "") {
            var refusal = "the host refused to queue " + key
            root.lastError = refusal
            if (callback)
                callback(false, null, refusal)
            root.failed("unavailable", refusal)
            return ""
        }
        root._pending[id] = callback
        root._pendingCount = root._pendingCount + 1
        return id
    }

    /** Drop a pending callback and ask the host to forget the request. */
    function cancel(id) {
        var key = String(id)
        var callback = root._pending[key]
        delete root._pending[key]
        if (callback !== undefined)
            root._pendingCount = Math.max(0, root._pendingCount - 1)
        return root.host && typeof root.host.cancelRequest === "function" ? root.host.cancelRequest(key) : false
    }

    /** Abandon every in-flight call (used when the page goes away). */
    function cancelAll() {
        for (var key in root._pending)
            cancel(key)
    }

    /** Correlates host replies with the callbacks registered in `call`. */
    property Connections _hostReplies: Connections {
        target: root.host

        function onRequestReplied(id, method, ok, result, error) {
            var key = String(id)
            var callback = root._pending[key]
            if (callback === undefined)
                return // a late reply to a cancelled request: nothing waits for it
            delete root._pending[key]
            root._pendingCount = Math.max(0, root._pendingCount - 1)
            if (ok) {
                root.lastError = ""
            } else if (String(error) !== "") {
                root.lastError = String(error)
            }
            if (callback)
                callback(ok === true, result, error)
        }
    }

    // ------------------------------------------------------- settings.page

    /** `settings.describe` → fills `descriptors`/`revision`. */
    function describe(namespace, callback) {
        var params = namespace === undefined || namespace === null || namespace === "" ? ({}) : ({ "ns": namespace })
        return call("settings.describe", params, function (ok, result, error) {
            if (ok) {
                root.descriptors = result && result.namespaces ? result.namespaces : []
                root.revision = result && result.revision !== undefined ? Number(result.revision) : -1
                root.loaded()
            }
            if (callback)
                callback(ok, result, error)
        })
    }

    /**
     * `settings.mutate`. `ops` must contain only `{op:'set'|'unset', path, value?}`.
     * `expectedRevision` is passed through; a conflict arrives with `conflict`.
     */
    function mutate(namespace, ops, expectedRevision, callback) {
        var params = { "ns": String(namespace), "ops": ops }
        if (expectedRevision !== undefined && expectedRevision !== null)
            params["expectedRevision"] = Number(expectedRevision)
        return call("settings.mutate", params, function (ok, result, error) {
            var conflict = !ok && String(error).indexOf("conflict") !== -1
            if (ok)
                root.describe(namespace)
            root.mutated(String(namespace), conflict)
            if (callback)
                callback(ok, result, error)
        })
    }

    // ------------------------------------------------------- models.page

    /** `llm.providers.list` → fills `providers`. */
    function loadProviders(callback) {
        return call("llm.providers.list", ({}), function (ok, result, error) {
            if (ok) {
                root.providers = result && result.providers ? result.providers : []
            }
            if (callback)
                callback(ok, result, error)
        })
    }

    /**
     * `llm.models.discover`. `params` may carry `{settingsNs, provider?,
     * baseURL?, api?, apiKey?}`. The apiKey, when present, is used by the host
     * for this one call; the host never stores or echoes it.
     */
    function discover(params, callback) {
        return call("llm.models.discover", params, function (ok, result, error) {
            if (callback)
                callback(ok, result, error)
        })
    }

    /** `llm.models.cancel`; safe to call for an operation that already settled. */
    function cancelDiscover(operationId, callback) {
        return call("llm.models.cancel", { "operationId": String(operationId) }, function (ok, result, error) {
            if (callback)
                callback(ok, result, error)
        })
    }

    /** `llm.default.get` → fills `defaultSelection`. */
    function loadDefault(callback) {
        return call("llm.default.get", ({}), function (ok, result, error) {
            if (ok) {
                root.defaultSelection = result && result.selection ? result.selection : ({})
                root.defaultChanged()
            }
            if (callback)
                callback(ok, result, error)
        })
    }

    /** `llm.default.set`; reports `unsupported` when the profile cannot persist. */
    function saveDefault(selection, callback) {
        return call("llm.default.set", selection, function (ok, result, error) {
            if (ok) {
                root.defaultSelection = result && result.selection ? result.selection : root.defaultSelection
                root.defaultChanged()
            }
            if (callback)
                callback(ok, result, error)
        })
    }

    // --------------------------------------------------- credentials.page

    /** `cred.describe` — configured/source/writable only, never the value. */
    function describeCredential(ref, callback) {
        return call("cred.describe", { "ref": String(ref) }, callback)
    }

    /** `cred.set` — the value is a transient draft; nothing echoes it back. */
    function setCredential(ref, value, callback) {
        return call("cred.set", { "ref": String(ref), "value": String(value) }, callback)
    }

    /** `cred.unset`. */
    function unsetCredential(ref, callback) {
        return call("cred.unset", { "ref": String(ref) }, callback)
    }

    /** `cred.list` — record keys and kinds only. */
    function listCredentials(callback) {
        return call("cred.list", ({}), callback)
    }
}